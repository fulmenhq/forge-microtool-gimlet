# Gimlet Environment Variables
# Copy this file to .env for local development
# All variables are optional with sensible defaults

# Logging
GIMLET_LOG_LEVEL=info                     # trace|debug|info|warn|error

# Configuration
GIMLET_CONFIG_PATH=~/.config/fulmenhq/gimlet.yaml  # Path to config file (optional)

# Example application-specific variables
# GIMLET_MAX_DEPTH=10                      # Default max depth for file traversal
# GIMLET_EXCLUDE_PATTERNS=.git/,vendor/    # Default exclude patterns
